include README.md
include CHANGELOG.md
include LICENSE
include CITATION.cff
include CONTRIBUTING.md
include pyproject.toml
include tools/build_release.py
include .github/workflows/tests.yml
recursive-include docs *.md
recursive-include docs *.py *.txt *.css *.png *.csv
include .github/workflows/docs.yml
recursive-include templates *.sh
recursive-include examples *.json *.md
recursive-include tests *.py
prune archive
